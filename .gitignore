# 依存関係
node_modules/
__pycache__/
.venv/
venv/
vendor/bin/

# ビルド成果物
dist/
build/
.svelte-kit/
target/
*.egg-info/

# カバレッジの出力(G-5 の test ジョブが毎回作る。coverage-check が読む)
coverage/
.nyc_output/
coverage.json
coverage.out

# 出荷判定の証跡の作業領域(集約が毎回書く。ルート直下だけ)。docs/evidence/ は出荷の PR が保証の開示を置く記録の置き場であり、無視しない
/evidence/

# 秘匿情報。強制層の設定でも参照を遮断するが、混入の経路をここでも塞ぐ
.env
.env.*
!.env.example
*.pem
*.key

# エディタ・OS
.DS_Store
Thumbs.db
.idea/
.vscode/
!.vscode/extensions.json

# 一時領域
tmp/
.cache/
*.log

# テスト・カバレッジの中間生成物
coverage.json
.coverage
.pytest_cache/
.ruff_cache/
